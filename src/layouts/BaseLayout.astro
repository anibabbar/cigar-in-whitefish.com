---
import SEOHead, { type BreadcrumbItem, type FAQItem } from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { FeaturedImage, SEOMetadata } from '../content.config';

export interface Props {
  title?: string;
  description?: string;
  seo?: Partial<SEOMetadata>;
  featuredImage?: FeaturedImage;
  type?: 'website' | 'article';
  pubDate?: Date | string;
  updatedDate?: Date | string;
  breadcrumbs?: BreadcrumbItem[];
  faq?: FAQItem[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#fbf9f6] text-[#262422] antialiased selection:bg-[#3d2b21] selection:text-[#fbf9f6]">
  <head>
    <SEOHead {...props} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#fbf9f6] text-[#262422] font-sans">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#3d2b21] focus:text-[#fbf9f6] focus:rounded-md focus:font-bold"
    >
      Skip to content
    </a>

    <!-- Sticky Header Navigation -->
    <Navbar />

    <!-- Main Page Content -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Comprehensive Footer -->
    <Footer />
  </body>
</html>
