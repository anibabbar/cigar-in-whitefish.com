---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { path } from '../utils/paths';

const seo = {
  metaTitle: `Privacy Policy & Terms | ${site.siteName}`,
  metaDescription: `Review the privacy policy, data practices, age verification terms, and cookie disclosure for ${site.siteName}.`,
  primaryKeyword: `Privacy Policy`,
  noIndex: true,
};

const breadcrumbs = [
  { name: 'Home', url: path('/') },
  { name: 'Privacy Policy', url: path('/privacy-policy') },
];
---

<BaseLayout
  title={`Privacy Policy & Terms | ${site.siteName}`}
  seo={seo}
  breadcrumbs={breadcrumbs}
>
  <div class="py-12 sm:py-16 lg:py-20 bg-[#fbf9f6]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-[#78716c] mb-8 font-medium" aria-label="Breadcrumb">
        <a href={path('/')} class="hover:text-[#1c1917] transition-colors">home</a>
        <span>/</span>
        <span class="text-[#1c1917]" aria-current="page">privacy policy</span>
      </nav>

      <!-- Page Header -->
      <header class="mb-10 pb-8 border-b border-[#e9e3da]">
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#1c1917] font-normal mb-3">
          Privacy Policy
        </h1>
        <p class="text-xs sm:text-sm text-[#78716c]">
          Last updated: February 2025 • Effective immediately for {site.siteName}
        </p>
      </header>

      <!-- Content -->
      <div class="prose prose-stone max-w-none prose-headings:font-serif prose-headings:font-normal prose-headings:text-[#1c1917] prose-p:text-[#44403c] prose-li:text-[#44403c]">
        <h2>1. Overview and Intent</h2>
        <p>
          At <strong>{site.siteName}</strong> ("we," "our," or "us"), we value your privacy. This policy explains what information is collected when you visit our website ({site.cityOrRegion}), how that information is utilized, and your choices regarding your personal data.
        </p>

        <h2>2. Age Verification Notice (21+)</h2>
        <p>
          This website contains educational and commercial information regarding cigars and related tobacco lifestyle products. In compliance with Federal and Montana state laws, our physical facility and services are restricted exclusively to adults aged twenty-one (21) years or older. We do not intentionally market to or collect data from persons under 21 years of age.
        </p>

        <h2>3. Information We Collect</h2>
        <p>
          We do not require users to register accounts or submit personal data merely to view public informational pages. We collect personal data only when voluntarily submitted:
        </p>
        <ul>
          <li>
            <strong>Contact Inquiries:</strong> When you complete our contact or locker reservation form, your name, email address, phone number, and message are securely transmitted via Web3Forms to our customer concierge.
          </li>
          <li>
            <strong>Technical Log Files:</strong> Like standard web hosts, our static hosting platform (e.g., Cloudflare Pages) may automatically log standard diagnostic requests including IP addresses, browser types, referring pages, and access timestamps for security and threat mitigation.
          </li>
        </ul>

        <h2>4. Use of Personal Information</h2>
        <p>
          Information submitted through our website forms is strictly used to:
        </p>
        <ul>
          <li>Respond to your direct inquiries regarding cigar availability, rare box allocations, curbside pickup, or event cigar packages.</li>
          <li>Coordinate retail consultations or product availability in Whitefish, Montana.</li>
          <li>Ensure website stability and prevent automated spam submissions.</li>
        </ul>
        <p>
          We do not sell, rent, monetize, or trade your contact information to third-party marketing companies.
        </p>

        <h2>5. Cookies and Web Analytics</h2>
        <p>
          This starter website is optimized for lightning-fast static delivery and does not load intrusive third-party cross-site advertising cookies. Any minimal analytical tracking used is aggregated, anonymous, and focused strictly on improving performance and page navigation.
        </p>

        <h2>6. Data Security &amp; Third-Party Services</h2>
        <p>
          Our forms are processed through Web3Forms, which uses end-to-end HTTPS encryption during transit. While no digital platform is invulnerable, we implement rigorous industry-standard safeguards to secure any communications.
        </p>

        <h2>7. Contact Information</h2>
        <p>
          If you have questions or requests regarding your personal information, please contact us:
        </p>
        <p>
          <strong>{site.siteName}</strong><br />
          Location: {site.cityOrRegion}<br />
          Phone: {site.phone}<br />
          Email: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>

    </div>
  </div>
</BaseLayout>
