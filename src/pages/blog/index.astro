---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import site from '../../data/site.json';
import { getPublishedBlogPosts, getPostSlug } from '../../utils/content';
import { getReadingTime } from '../../utils/readingTime';

const posts = await getPublishedBlogPosts();
const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const seo = {
  metaTitle: `Journal & Guides | ${site.siteName}`,
  metaDescription: `Read expert cigar guides, Montana whiskey pairings, humidor humidity tips, and vitola recommendations from the master tobacconists at ${site.siteName}.`,
  primaryKeyword: site.primaryKeyword,
  secondaryKeywords: ['Whitefish cigar blog', 'cigars in Whitefish MT', 'cigar shop Whitefish Montana', 'Montana cigar tasting', 'cigar guides'],
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Journal', url: '/blog' },
];
---

<BaseLayout
  title={`Journal & Guides | ${site.siteName}`}
  seo={seo}
  breadcrumbs={breadcrumbs}
>
  <div class="py-12 sm:py-16 lg:py-20 bg-[#fbf9f6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <header class="max-w-3xl mb-12 space-y-3">
        <nav class="flex items-center gap-2 text-xs text-[#78716c] font-medium" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#1c1917] transition-colors">home</a>
          <span>/</span>
          <span class="text-[#1c1917]" aria-current="page">journal</span>
        </nav>
        
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#1c1917] font-normal">
          The Cigar Journal
        </h1>
        <p class="font-serif text-lg text-[#78716c] italic font-light leading-relaxed">
          Where passion meets tradition. Tasting notes, pairing rituals, and humidor craft from Whitefish, Montana.
        </p>
      </header>

      <!-- Featured Hero Post -->
      {featuredPost && (
        <section class="mb-16">
          <div class="bg-[#ffffff] border border-[#e9e3da] rounded-2xl overflow-hidden hover:border-[#c5b5a2] transition-all duration-300 grid grid-cols-1 lg:grid-cols-12 group shadow-sm">
            
            <a href={`/blog/${getPostSlug(featuredPost)}`} class="lg:col-span-7 relative aspect-[16/10] lg:aspect-auto overflow-hidden bg-stone-100">
              <img
                src={featuredPost.data.featuredImage?.src || '/images/uploads/default-og.jpg'}
                alt={featuredPost.data.featuredImage?.alt || featuredPost.data.title}
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-500"
                loading="eager"
              />
              <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider bg-[#ffffff]/95 text-[#1c1917] shadow-sm backdrop-blur-sm">
                Featured Guide
              </span>
            </a>

            <div class="lg:col-span-5 p-8 lg:p-10 flex flex-col justify-between">
              <div class="space-y-4">
                <div class="flex items-center gap-3 text-xs text-[#78716c] font-medium">
                  <time datetime={new Date(featuredPost.data.pubDate).toISOString()}>
                    {new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(featuredPost.data.pubDate))}
                  </time>
                  <span>•</span>
                  <span>{getReadingTime(featuredPost.body || '')}</span>
                </div>

                <h2 class="font-serif text-2xl sm:text-3xl text-[#1c1917] font-normal group-hover:text-[#57534e] transition-colors leading-snug">
                  <a href={`/blog/${getPostSlug(featuredPost)}`}>
                    {featuredPost.data.title}
                  </a>
                </h2>

                <p class="text-[#57534e] text-sm leading-relaxed line-clamp-4 font-light">
                  {featuredPost.data.seo?.metaDescription || featuredPost.body?.slice(0, 180) + '...'}
                </p>
              </div>

              <div class="pt-6 mt-6 border-t border-[#f7f4ef]">
                <a
                  href={`/blog/${getPostSlug(featuredPost)}`}
                  class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#1c1917] group-hover:text-[#78716c]"
                >
                  Read Full Guide &rarr;
                </a>
              </div>
            </div>

          </div>
        </section>
      )}

      <!-- Remaining Posts Grid -->
      {remainingPosts.length > 0 && (
        <section>
          <h2 class="font-serif text-2xl font-normal text-[#1c1917] mb-8">
            More Articles &amp; Insights
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {remainingPosts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        </section>
      )}

    </div>
  </div>
</BaseLayout>
