---
import BaseLayout from '../../layouts/BaseLayout.astro';
import cigarInventory from '../../data/cigarInventory.json';
import site from '../../data/site.json';

const seo = {
  metaTitle: `Cigar Brands in Whitefish, MT | ${site.siteName} & Walk-In Humidor`,
  metaDescription: `Explore all 26 premium handmade and everyday cigar brands at ${site.siteName} in Whitefish, MT. Padrón, Fuente, Davidoff, Plasencia, Backwoods, and more in our walk-in humidor.`,
  primaryKeyword: `Cigars in Whitefish, MT`,
  secondaryKeywords: [
    'cigar brands Whitefish MT',
    'buy cigars Whitefish Montana',
    'walk-in humidor Flathead Valley',
    'premium cigar shop Whitefish',
  ],
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Cigars', url: '/cigars' },
];
---

<BaseLayout
  title={`Cigar Brands in Whitefish, MT | ${site.siteName}`}
  seo={seo}
  breadcrumbs={breadcrumbs}
>
  <div class="py-12 sm:py-16 lg:py-20 bg-[#fbf9f6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <header class="max-w-3xl mb-16 space-y-3">
        <nav class="flex items-center gap-2 text-xs text-[#78716c] font-medium" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#1c1917] transition-colors">home</a>
          <span>/</span>
          <span class="text-[#1c1917]" aria-current="page">cigars</span>
        </nav>
        
        <p class="text-xs uppercase tracking-widest text-[#78716c] font-semibold">
          Downtown Whitefish Humidor Collection
        </p>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#1c1917] font-normal">
          Cigar Brands in Whitefish, Montana
        </h1>
        <p class="font-serif text-lg text-[#78716c] italic font-light leading-relaxed">
          From legendary aged vitolas to everyday natural leaf wraps, explore our complete portfolio rested at an optimal 67% relative humidity.
        </p>
      </header>

      <!-- Category 1: Handmade Premium Cigars (21 Brands) -->
      <section class="mb-20">
        <div class="flex items-center justify-between gap-4 mb-8 pb-3 border-b border-[#e9e3da]">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl text-[#1c1917] font-normal">
              Handmade Premium Cigars
            </h2>
            <p class="text-xs text-[#78716c] mt-1 font-light">
              World-renowned master blenders from Nicaragua, the Dominican Republic, and Honduras.
            </p>
          </div>
          <span class="text-xs uppercase tracking-wider text-[#78716c] font-medium bg-[#ffffff] px-3 py-1 rounded-full border border-[#e9e3da] shrink-0">
            {cigarInventory.handmadePremium.length} Iconic Houses
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {cigarInventory.handmadePremium.map((cigar) => (
            <a
              href={`/cigars/${cigar.slug}`}
              class="p-6 rounded-2xl bg-[#ffffff] border border-[#e9e3da] hover:border-[#1c1917] transition-all flex flex-col justify-between group shadow-xs hover:shadow-sm"
            >
              <div class="space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-serif text-xl font-bold text-[#1c1917] group-hover:text-[#835f47] transition-colors">
                    {cigar.name}
                  </h3>
                  <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded bg-[#fbf9f6] text-[#78716c] border border-[#e9e3da] shrink-0 font-medium">
                    {cigar.category}
                  </span>
                </div>
                <p class="text-xs font-semibold text-[#835f47]">
                  {cigar.tagline}
                </p>
                <p class="text-xs text-[#57534e] leading-relaxed font-light line-clamp-3">
                  {cigar.notes}
                </p>
              </div>

              <div class="pt-4 border-t border-[#f7f4ef] flex items-center justify-between text-xs text-[#1c1917] font-semibold group-hover:text-[#835f47]">
                <span>View brand details &amp; vitolas</span>
                <span>&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Category 2: Regular Cigars & Natural Leaf Classics (5 Brands) -->
      <section>
        <div class="flex items-center justify-between gap-4 mb-8 pb-3 border-b border-[#e9e3da]">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl text-[#1c1917] font-normal">
              Everyday Classics &amp; Natural Leaf
            </h2>
            <p class="text-xs text-[#78716c] mt-1 font-light">
              Fresh foil pouches, pipe tobacco cigarillos, and all-natural broadleaf cigars.
            </p>
          </div>
          <span class="text-xs uppercase tracking-wider text-[#78716c] font-medium bg-[#ffffff] px-3 py-1 rounded-full border border-[#e9e3da] shrink-0">
            {cigarInventory.regularClassics.length} Classic Lines
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {cigarInventory.regularClassics.map((item) => (
            <a
              href={`/cigars/${item.slug}`}
              class="p-6 rounded-2xl bg-[#ffffff] border border-[#e9e3da] hover:border-[#1c1917] transition-all flex flex-col justify-between group shadow-xs hover:shadow-sm"
            >
              <div class="space-y-4">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-serif text-xl font-bold text-[#1c1917] group-hover:text-[#835f47] transition-colors">
                    {item.name}
                  </h3>
                  <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded bg-[#fbf9f6] text-[#78716c] border border-[#e9e3da] shrink-0 font-medium">
                    {item.type}
                  </span>
                </div>
                <p class="text-xs text-[#57534e] leading-relaxed font-light">
                  {item.notes || item.description}
                </p>
                <div>
                  <span class="text-[11px] font-semibold text-[#1c1917] block mb-1.5 uppercase tracking-wider">
                    In Stock Flavors:
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {item.variants.slice(0, 5).map((variant) => (
                      <span class="text-[10px] px-2 py-0.5 rounded bg-[#fbf9f6] text-[#57534e] border border-[#e9e3da]">
                        {variant}
                      </span>
                    ))}
                    {item.variants.length > 5 && (
                      <span class="text-[10px] px-2 py-0.5 rounded bg-[#fbf9f6] text-[#78716c] border border-[#e9e3da]">
                        +{item.variants.length - 5} more
                      </span>
                    )}
                  </div>
                </div>
              </div>

              <div class="pt-4 border-t border-[#f7f4ef] flex items-center justify-between text-xs text-[#1c1917] font-semibold group-hover:text-[#835f47]">
                <span>View all flavors &amp; packs</span>
                <span>&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
