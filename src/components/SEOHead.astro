---
import site from '../data/site.json';
import path from '../utils/paths';
import type { FeaturedImage, SEOMetadata } from '../content.config';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  description?: string;
  seo?: Partial<SEOMetadata>;
  featuredImage?: FeaturedImage;
  type?: 'website' | 'article';
  pubDate?: Date | string;
  updatedDate?: Date | string;
  breadcrumbs?: BreadcrumbItem[];
  faq?: FAQItem[];
}

const {
  title,
  description,
  featuredImage,
  type = 'website',
  pubDate,
  updatedDate,
  breadcrumbs,
  faq,
} = Astro.props;

const seo: Partial<SEOMetadata> = Astro.props.seo || {};

const siteUrl = Astro.site ? Astro.site.origin : 'https://example.com';
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';

// Meta title resolution
const resolvedTitle = seo.metaTitle
  ? seo.metaTitle
  : title
    ? isHome
      ? title
      : `${title} | ${site.siteName}`
    : `${site.primaryKeyword} | ${site.siteName}`;

// Meta description resolution
const resolvedDescription = seo.metaDescription || description || site.defaultMetaDescription;

// Canonical URL resolution
const resolvedCanonical = seo.canonicalUrl
  ? seo.canonicalUrl
  : new URL(currentPath, siteUrl).href;

// Image resolution in priority: seo.ogImage -> featuredImage.src -> site.defaultOgImage
const rawImage = seo.ogImage || featuredImage?.src || site.defaultOgImage;
const resolvedImage = rawImage.startsWith('http')
  ? rawImage
  : new URL(path(rawImage), siteUrl).href;
const resolvedImageAlt = featuredImage?.alt || resolvedTitle;

// Keywords resolution
const allKeywords: string[] = [];
if (seo.primaryKeyword) {
  allKeywords.push(seo.primaryKeyword);
} else if (isHome && site.primaryKeyword) {
  allKeywords.push(site.primaryKeyword);
}
if (seo.secondaryKeywords && Array.isArray(seo.secondaryKeywords)) {
  allKeywords.push(...seo.secondaryKeywords);
}
if (isHome && (!seo.secondaryKeywords || seo.secondaryKeywords.length === 0)) {
  allKeywords.push(
    'cigar shop whitefish mt',
    'whitefish cigar shop',
    'smoke shop whitefish montana',
    'walk-in humidor whitefish',
    'premium cigars flathead valley',
    'buy cigars whitefish mt',
    'tobacco shop whitefish'
  );
}
const keywordsString = allKeywords.filter(Boolean).join(', ');

// Dates
const isoPubDate = pubDate ? new Date(pubDate).toISOString() : undefined;
const isoUpdatedDate = updatedDate ? new Date(updatedDate).toISOString() : isoPubDate;

// Breadcrumbs resolution
const breadcrumbItems: BreadcrumbItem[] = breadcrumbs || [
  { name: 'Home', url: siteUrl },
  ...(isHome ? [] : [{ name: title || resolvedTitle, url: resolvedCanonical }]),
];

// Structured Data Schemas
const schemas: Record<string, unknown>[] = [];

if (isHome) {
  // WebSite Schema
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.siteName,
    url: siteUrl,
    description: site.defaultMetaDescription,
    keywords: keywordsString || site.primaryKeyword,
  });

  // TobaccoShop & LocalBusiness Schema
  schemas.push({
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'Store', 'TobaccoShop'],
    name: site.siteName,
    alternateName: '555 Smoke Shop & Walk-in Humidor',
    description: site.defaultMetaDescription,
    telephone: site.phone,
    email: site.email,
    url: siteUrl,
    image: resolvedImage,
    priceRange: '$$$',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '3555 US-93',
      addressLocality: 'Kalispell',
      addressRegion: 'MT',
      postalCode: '59901',
      addressCountry: 'US',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 48.2435,
      longitude: -114.3385,
    },
    areaServed: [
      { '@type': 'City', name: 'Whitefish', sameAs: 'https://en.wikipedia.org/wiki/Whitefish,_Montana' },
      { '@type': 'City', name: 'Kalispell', sameAs: 'https://en.wikipedia.org/wiki/Kalispell,_Montana' },
      { '@type': 'AdministrativeArea', name: 'Flathead County' },
      { '@type': 'City', name: 'Columbia Falls' },
    ],
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '08:00',
        closes: '20:00',
      },
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Saturday'],
        opens: '10:00',
        closes: '21:00',
      },
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: 'Sunday',
        opens: '10:00',
        closes: '18:00',
      },
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Cigar & Tobacco Offerings in Whitefish, MT',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Product',
            name: 'Handmade Premium Cigars (Padrón, Fuente, Davidoff, Oliva, Plasencia)',
            category: 'Cigars',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Product',
            name: 'Walk-In Spanish Cedar Humidor Selections',
            category: 'Cigars',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Product',
            name: 'Classic Natural Leaf Cigars & Wraps (Backwoods, Black & Mild, Game)',
            category: 'Tobacco',
          },
        },
      ],
    },
    keywords: keywordsString || site.primaryKeyword,
  });
} else if (type === 'article') {
  // BlogPosting Schema
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: resolvedTitle,
    description: resolvedDescription,
    image: resolvedImage,
    datePublished: isoPubDate,
    dateModified: isoUpdatedDate,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': resolvedCanonical,
    },
    author: {
      '@type': 'Organization',
      name: site.siteName,
      url: siteUrl,
    },
    publisher: {
      '@type': 'Organization',
      name: site.siteName,
      logo: {
        '@type': 'ImageObject',
        url: new URL(path(site.defaultOgImage), siteUrl).href,
      },
    },
    keywords: keywordsString,
  });
} else {
  // WebPage Schema
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: resolvedTitle,
    description: resolvedDescription,
    url: resolvedCanonical,
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: resolvedImage,
    },
    keywords: keywordsString,
  });
}

// BreadcrumbList Schema (for non-home pages)
if (!isHome && breadcrumbItems.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url.startsWith('http') ? item.url : new URL(item.url, siteUrl).href,
    })),
  });
}

// FAQPage Schema if faq items are passed
if (faq && faq.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}
---

<!-- Core Meta Tags -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
{keywordsString && <meta name="keywords" content={keywordsString} />}
<link rel="canonical" href={resolvedCanonical} />

<!-- Robots Control -->
{seo.noIndex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Favicons & Manifest -->
<link rel="icon" type="image/svg+xml" href={path('/favicon.svg')} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap" rel="stylesheet" />
<link rel="sitemap" href={path('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={site.siteName} href={path('/rss.xml')} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:site_name" content={site.siteName} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:alt" content={resolvedImageAlt} />
<meta property="og:locale" content="en_US" />

{type === 'article' && isoPubDate && (
  <meta property="article:published_time" content={isoPubDate} />
)}
{type === 'article' && isoUpdatedDate && (
  <meta property="article:modified_time" content={isoUpdatedDate} />
)}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={resolvedImage} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

<!-- JSON-LD Structured Data Injection -->
{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
