---
import site from '../data/site.json';
import { getPublishedPages, getPageSlug } from '../utils/content';
import path from '../utils/paths';

const pages = await getPublishedPages();
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#fbf9f6] text-[#57534e] border-t border-[#e9e3da]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Brand & Mission Column -->
      <div class="space-y-4">
        <a href={path('/')} class="inline-block">
          <img
            src={path(site.logo || '/images/logo-new-smoke-shop.png')}
            alt={site.siteName}
            class="h-9 w-auto object-contain hover:opacity-95 transition-opacity mb-1"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-[#78716c] leading-relaxed">
          {site.defaultMetaDescription}
        </p>
        <div class="pt-1 text-xs text-[#a8a29e] uppercase tracking-widest font-medium">
          {site.googleMapsUrl ? (
            <a href={site.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#57534e] transition-colors">
              3555 US-93, Kalispell, MT 59901
            </a>
          ) : (
            <span>3555 US-93, Kalispell, MT 59901</span>
          )}
          &bull; Walk-In Humidor
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[#1c1917] mb-4">
          Explore
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={path('/')} class="hover:text-[#1c1917] transition-colors">home</a>
          </li>
          <li>
            <a href={path('/cigars')} class="hover:text-[#1c1917] transition-colors">cigars</a>
          </li>
          {pages.map((page) => {
            const slug = getPageSlug(page);
            return (
              <li>
                <a href={path(`/${slug}`)} class="hover:text-[#1c1917] transition-colors">
                  {slug === 'about' ? 'about' : slug === 'services' ? 'services' : page.data.title.toLowerCase()}
                </a>
              </li>
            );
          })}
          <li>
            <a href={path('/blog')} class="hover:text-[#1c1917] transition-colors">journal</a>
          </li>
          <li>
            <a href={path('/contact')} class="hover:text-[#1c1917] transition-colors">contact</a>
          </li>
        </ul>
      </div>

      <!-- Visit & Hours -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[#1c1917] mb-4">
          Visit &amp; Hours
        </h3>
        <ul class="space-y-3 text-sm">
          <li>
            <strong class="block text-[#1c1917] font-medium">Store Address</strong>
            {site.googleMapsUrl ? (
              <a
                href={site.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#57534e] hover:text-[#1c1917] transition-colors group inline-block"
              >
                <span>3555 US-93, Kalispell, MT 59901</span>
                <span class="block text-xs text-[#835f47] group-hover:underline mt-0.5">
                  Get Driving Directions &rarr;
                </span>
              </a>
            ) : (
              <span class="text-[#57534e]">3555 US-93, Kalispell, MT 59901</span>
            )}
          </li>
          <li class="pt-1">
            <strong class="block text-[#1c1917] font-medium mb-1">Store Hours</strong>
            <div class="text-xs space-y-1 text-[#57534e]">
              <div><span class="font-medium text-[#1c1917]">Mon–Fri:</span> 8:00 AM – 8:00 PM</div>
              <div><span class="font-medium text-[#1c1917]">Sat:</span> 10:00 AM – 9:00 PM</div>
              <div><span class="font-medium text-[#1c1917]">Sun:</span> 10:00 AM – 6:00 PM</div>
            </div>
          </li>
          {site.phone && (
            <li class="pt-1">
              <a href={`tel:${site.phone.replace(/[^0-9]/g, '')}`} class="hover:text-[#1c1917] transition-colors font-medium">
                {site.phone}
              </a>
            </li>
          )}
          {site.email && (
            <li>
              <a href={`mailto:${site.email}`} class="hover:text-[#1c1917] transition-colors break-all">
                {site.email}
              </a>
            </li>
          )}
        </ul>
      </div>

      <!-- Legal & Feeds -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[#1c1917] mb-4">
          Information
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={path('/privacy-policy')} class="hover:text-[#1c1917] transition-colors">
              Privacy Policy &amp; Terms
            </a>
          </li>
          <li>
            <a href={path('/sitemap-index.xml')} class="hover:text-[#1c1917] transition-colors">
              XML Sitemap
            </a>
          </li>
          <li>
            <a href={path('/rss.xml')} class="hover:text-[#1c1917] transition-colors">
              RSS Feed
            </a>
          </li>
          <li class="pt-2 text-xs text-[#a8a29e] italic leading-relaxed">
            Must be 21+ to purchase tobacco products in Montana.
          </li>
        </ul>
      </div>

    </div>

    <!-- Copyright Sub-footer -->
    <div class="mt-12 pt-8 border-t border-[#e9e3da] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#a8a29e]">
      <p>
        &copy; {currentYear} {site.siteName.toLowerCase()} . All rights reserved.
      </p>
      <p class="text-center sm:text-right text-[#78716c]">
        Mon-Fri: 8AM-8PM | Sat: 10AM-9PM | Sun: 10AM-6PM &bull;{" "}
        {site.googleMapsUrl ? (
          <a
            href={site.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#1c1917] hover:underline transition-colors"
          >
            3555 US-93, Kalispell, MT 59901
          </a>
        ) : (
          <span>3555 US-93, Kalispell, MT 59901</span>
        )}
      </p>
    </div>
  </div>
</footer>
